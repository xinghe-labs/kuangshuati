<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动窗口底色必须是**纯色**：MIUI 的 StartingSurfaceDrawer 会从
         windowBackground 里取色（peekWindowBGColor），遇到 layer-list 直接抛
         Resources$NotFoundException，随后 NPE 掉整个启动窗口，露出黑屏。
         图标改由 Flutter 侧（features/splash）和 Android 12+ 的系统启动页负责。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background_color</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
